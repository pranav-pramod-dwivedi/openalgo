#!/usr/bin/env bash
# Paper trading - virtual money. Nothing here can reach a broker.
#
#   ./paper            make one trade, then stop
#   ./paper status     what it did and what it is doing now
#   ./paper stop       stop trading
#   ./paper help       the same three commands, with a word of explanation
#
# One command, one trade. There is no loop, no second attempt and no walking
# down a list of coins: each ./paper looks once, places at most one paper trade,
# prints what it did in plain words and stops.

set -euo pipefail

cd "$(dirname "$0")"
export PAPER_DB="${PAPER_DB:-data/paper.db}"
PIDFILE="${PAPER_PIDFILE:-log/paper_worker.pid}"
LOG="${PAPER_LOG:-log/paper_worker.log}"
export OPENCODE_API_KEY="${OPENCODE_API_KEY:-}"

say() { printf '\n  %s\n\n' "$*"; }
die() { printf '\n  %s\n\n' "$1" >&2; exit 1; }

help_text() {
  cat <<'HELP'

  Paper trading. Virtual money only - no broker is ever contacted.

    ./paper           Make one trade, then stop.
                      If nothing is worth trading, it says so and stops.
                      Starts the background worker first if it is not running.

    ./paper status    What it did, what it holds, and the last trade it placed.

    ./paper stop      Stop trading. Nothing is traded until you run ./paper again.

    ./paper help      This text.

  One command places one trade, at most, and then stops. Run it again for
  another. No real money is involved at any point.

HELP
}

worker_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

first_time_setup() {
  if [ -d .venv ] && [ -f .env ]; then
    return 0
  fi
  say "Setting things up (first run only, this takes a minute)"
  uv sync --quiet
  if [ ! -f .env ]; then
    cp .sample.env .env
    say "Created your .env file"
  fi
  mkdir -p log data
}

# The worker watches the account between commands. Start it here, quietly, so
# the user never has to learn a second command for it.
ensure_worker() {
  command -v uv >/dev/null 2>&1 || die "uv is not installed yet - see https://docs.astral.sh/uv/"
  first_time_setup
  worker_pid >/dev/null 2>&1 && return 0

  # Starting is also a resume: a previous ./paper stop left the switch set, and
  # asking to trade again means the user wants it trading.
  uv run python scripts/paper_worker.py --resume >/dev/null 2>&1 || true
  nohup uv run python scripts/paper_worker.py >"$LOG" 2>&1 &
  printf '%s' "$!" >"$PIDFILE"
  sleep 3
  if worker_pid >/dev/null 2>&1; then
    say "It is now watching the account in the background. This trade below is the only one this command places."
  else
    say "The background watcher did not start. The reason is at the end of $LOG. The trade below still goes ahead on its own."
  fi
}

# One trade. Exactly one: profitable_trade.py plans once, places once and exits,
# and it refuses a second order in the same run.
one_trade() {
  ensure_worker
  # One call site below, and one symbol at most. A bare ./paper leaves the choice
  # to the planner; ./paper trade SYMBOL narrows it to that one coin.
  local symbol="" summary
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    symbol="$1"
  fi
  set -- --yes --allow-rules-only --plain
  if [ -n "$symbol" ]; then
    set -- --symbol "$symbol" "$@"
  fi
  # What the user reads is the trade summary and nothing else. The script's own
  # log chatter - an unreachable reviewer, a provider message - goes to the log
  # file, because a trader cannot act on a status code.
  summary="$(mktemp "${TMPDIR:-/tmp}/paper-trade.XXXXXX")"
  uv run python scripts/profitable_trade.py "$@" >"$summary" 2>>"$LOG" || true
  cat "$summary"
  if [ ! -s "$summary" ]; then
    say "Nothing was sent. The reason is at the end of $LOG"
  fi
  rm -f "$summary"
}

show_status() {
  uv run python scripts/paper_status.py
}

case "${1:-}" in
  ""|trade)
    shift 2>/dev/null || true
    one_trade "$@"
    ;;
  status)
    show_status
    ;;
  stop)
    uv run python scripts/paper_worker.py --halt >/dev/null 2>&1 || true
    if pid="$(worker_pid)"; then
      kill "$pid" 2>/dev/null || true
      rm -f "$PIDFILE"
    fi
    say "Stopped. It will not trade again until you run ./paper"
    ;;
  help|--help|-h)
    help_text
    ;;
  *)
    help_text
    die "There is no '$1'. The commands are: ./paper    ./paper status    ./paper stop"
    ;;
esac
