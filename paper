#!/usr/bin/env bash
# Paper trading - virtual money. Nothing here can reach a broker.
#
#   ./paper          set up and start everything, then show what it's doing
#   ./paper status   what is it doing right now
#   ./paper trade    make one trade now (optionally: ./paper trade BTC)
#   ./paper stop     stop trading
#
# You do not need to remember any other command. If you want the details,
# they are in PAPER_TRADING.md.

set -euo pipefail

cd "$(dirname "$0")"
export PAPER_DB="${PAPER_DB:-data/paper.db}"
PIDFILE="log/paper_worker.pid"
LOG="log/paper_worker.log"
export OPENCODE_API_KEY="${OPENCODE_API_KEY:-}"

say() { printf '\n  %s\n\n' "$*"; }
die() { printf '\n  %s\n\n' "$1" >&2; exit 1; }

worker_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

first_time_setup() {
  [ -d .venv ] || [ -f uv.lock ] || true
  say "Setting things up (first run only, this takes a minute)"
  uv sync --quiet
  if [ ! -f .env ]; then
    cp .sample.env .env
    say "Created your .env file"
  fi
  mkdir -p log data
}

# Is the AI reviewer able to answer right now?
analyst_ok() {
  uv run python scripts/paper_status.py >/dev/null 2>&1 || true
  uv run python - <<'PY' >/dev/null 2>&1
from services.paper import jev
raise SystemExit(0 if jev.ask("probe", {"t": {"type": "score", "criteria": ["no", "yes"]}}) else 1)
PY
}

start_everything() {
  mkdir -p log
  # Starting is also a resume: if a previous ./paper stop left the switch set,
  # asking to start again means you want it trading.
  uv run python scripts/paper_worker.py --resume >/dev/null 2>&1 || true
  if ! pid="$(worker_pid)"; then
    nohup uv run python scripts/paper_worker.py >"$LOG" 2>&1 &
    printf '%s' "$!" >"$PIDFILE"
    sleep 4
  fi

  if pid="$(worker_pid)"; then
    say "Trading is running (process $pid). It keeps working on its own."
  else
    die "It did not start. The reason is at the end of $LOG"
  fi

  if analyst_ok; then
    say "The AI reviewer is answering, so every trade is checked by it before it is placed."
  else
    say "The AI reviewer is unavailable right now (its free allowance is used up).
So trading continues WITHOUT the reviewer. Those trades are risk-sized and
stop-protected, but nothing has double-checked them. Every such trade is
labelled 'unreviewed' on the dashboard.

It will start using the reviewer again by itself as soon as the allowance
returns. Nothing to do."
  fi
}

show_status() {
  uv run python scripts/paper_status.py
}

case "${1:-}" in
  ""|start)
    command -v uv >/dev/null 2>&1 || die "uv is not installed yet - see https://docs.astral.sh/uv/"
    first_time_setup
    start_everything
    show_status
    say "Dashboard: http://127.0.0.1:5001/paper"
    ;;
  status)
    show_status
    ;;
  trade)
    shift
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      uv run python scripts/profitable_trade.py --symbol "$1" --yes
    else
      uv run python scripts/profitable_trade.py "$@" --yes
    fi
    say "Dashboard: http://127.0.0.1:5001/paper"
    ;;
  stop)
    uv run python scripts/paper_worker.py --halt >/dev/null 2>&1 || true
    if pid="$(worker_pid)"; then
      kill "$pid" 2>/dev/null || true
      rm -f "$PIDFILE"
    fi
    say "Stopped. It will not trade again until you run ./paper"
    ;;
  *)
    say "Unknown option '$1'. Try: ./paper    ./paper status    ./paper trade    ./paper stop"
    exit 1
    ;;
esac